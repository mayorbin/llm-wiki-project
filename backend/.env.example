# LLM Wiki 环境变量配置模板 —— 复制为 .env 后修改

# 必填
LLM_WIKI_LLM_API_KEY=sk-your-key-here
LLM_WIKI_SECRET_KEY=replace-with-openssl-rand-hex-32

# 可选
LLM_WIKI_LLM_MODEL=deepseek/deepseek-v4-flash
LLM_WIKI_LLM_API_BASE=http://localhost:8000/v1
LLM_WIKI_DATA_DIR=./data
LLM_WIKI_PORT=8000
LLM_WIKI_LOG_LEVEL=INFO
